# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Development Mode
# DEV_MODE=true                          # Server-side: controls service_role key usage (bypasses RLS)
# NEXT_PUBLIC_DEV_MODE=true              # Client-side: controls login bypass UI
# NEXT_PUBLIC_DEV_USER_ID=your-test-user-id

# Supabase 登录（密码模式）需在 Dashboard 配置：
# 1. Authentication → URL Configuration → Site URL = 你的 Vercel 域名
# 2. Redirect URLs 添加：https://你的域名/auth/callback
# 3. Authentication → Providers → Email → 开启 Email；建议关闭 Confirm email（注册后可直接登录）

# Android APK（Capacitor 壳应用连接的线上地址，需 HTTPS）
# CAPACITOR_SERVER_URL=https://your-app.vercel.app
