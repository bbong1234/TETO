# =============================================================================
# 本地开发（复制为 .env.local，不要提交 Git）
# =============================================================================
# 本地 Postgres + 开发模式：npm run dev 即可，无需登录
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@127.0.0.1:5432/teto
DEV_MODE=true
NEXT_PUBLIC_DEV_MODE=true
NEXT_PUBLIC_DEV_USER_ID=0a80d616-ac29-4151-b43f-fd8985c7c8d5

# AI semantic parsing（可选）
# DEEPSEEK_API_KEY=

# 本地开发不需要 Supabase 环境变量

# =============================================================================
# Vercel 生产环境（在 Vercel Dashboard → Environment Variables 配置）
# =============================================================================
# NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# SUPABASE_SERVICE_ROLE_KEY=eyJ...
#
# 生产环境请勿配置：DATABASE_URL、DEV_MODE、NEXT_PUBLIC_DEV_MODE
#
# Supabase 建表见：sql/bootstrap/SUPABASE_PRODUCTION.md

# Android APK（Capacitor 壳应用连接的线上 HTTPS 地址）
# CAPACITOR_SERVER_URL=https://your-app.vercel.app
